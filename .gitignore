# Godot 4+ specific ignores
.godot/

# Residuos del editor (los `Mai*.tmp` de la raíz volvían solos)
*.tmp

# Artefactos de export (`tools/export.sh`). `export_presets.cfg` SÍ se versiona: no lleva secretos.
builds/
export/
# La clave de Augur de prod que `tools/export.sh` escribe para meterla en el .pck y borra al salir.
# Si un export se corta y se queda, esto evita que entre en git.
augur_release.cfg
*.pck
*.exe
*.x86_64
*.apk
*.aab
*.dmg
*.wasm

# ⚠️ Los ficheros `.uid` NO se ignoran: Godot 4.4+ genera uno por script y
# son parte del proyecto. Si se ignoran, Godot los regenera y las referencias
# entre escenas se rompen.

# Capturas de `tools/ver_dilema.gd` — se regeneran, no se versionan.
capturas/
